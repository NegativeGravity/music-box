# Local defaults do not require external services.
MUSICBOX_DATA_DIR=.data
MUSICBOX_ENABLE_CLAP=0
MUSICBOX_AI_ENGINE=yue2
# Absolute directory containing the installed YuE2 runtime.json, runtime/ and models/.
# MUSICBOX_YUE2_ROOT=C:/path/to/musicbox/.data/ai-music/yue2
MUSICBOX_SECURE_COOKIE=0
MUSICBOX_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Optional: configure a stable secret instead of the generated .data/django.secret.
# DJANGO_SECRET_KEY=your-generated-secret
# Frontend proxy destination (set before building).
API_ORIGIN=http://127.0.0.1:8000
# For a managed PostgreSQL deployment, install psycopg and configure:
# DATABASE_URL=postgresql+psycopg://user:password@localhost/musicbox
